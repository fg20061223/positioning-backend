<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.positioning.business.mapper.ShopCategoryMapper">

    <!-- 商铺分类下拉数据（仅 id + cat_name, 可按商场过滤） -->
    <select id="selectOptions" resultType="com.positioning.business.dto.OptionVO">
        SELECT id, cat_name AS name
        FROM shop_category
        WHERE deleted = 0
          AND status = 1
        <if test="mallId != null">
          AND (mall_id = #{mallId} OR mall_id IS NULL)
        </if>
        ORDER BY sort_order, id
    </select>

</mapper>
