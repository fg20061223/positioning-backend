<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.positioning.business.mapper.MallFloorMapper">

    <!-- 楼层下拉数据（仅 id + floor_name, 可按商场过滤） -->
    <select id="selectOptions" resultType="com.positioning.business.dto.OptionVO">
        SELECT id, floor_name AS name
        FROM mall_floor
        WHERE deleted = 0
          AND status = 1
        <if test="mallId != null">
          AND mall_id = #{mallId}
        </if>
        ORDER BY sort_order, id
    </select>

</mapper>
