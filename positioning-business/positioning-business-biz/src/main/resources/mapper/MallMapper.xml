<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.positioning.business.mapper.MallMapper">

    <!-- 商场下拉数据（仅 id + mall_name） -->
    <select id="selectOptions" resultType="com.positioning.business.dto.OptionVO">
        SELECT id, mall_name AS name
        FROM mall
        WHERE deleted = 0
        ORDER BY id
    </select>

</mapper>
