<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.positioning</groupId>
        <artifactId>positioning-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>positioning-common</artifactId>
    <name>positioning-common</name>
    <description>公共模块: 统一返回、分页、异常（不依赖 Web 容器，网关与业务模块均可引用）</description>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 仅编译依赖: MyBatis 类型处理器注解/基类(与 mybatis-plus 3.5.12 内置的 3.5.19 一致) -->
        <!-- optional 不向网关等下游传递, 运行时由各 biz 模块的 mybatis-plus 提供 -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
            <version>3.5.19</version>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
